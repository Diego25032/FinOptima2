%% FinOptima - servicios de cuenta, administracion y soporte (capa Logica)
classDiagram
    direction LR

    class ServicioAutenticacion {
        +IniciarSesion(correo, contrasena) ResultadoLogin
        +Registrar(nombre, correo, contrasena, confirmacion) Resultado
        +CerrarSesion()
    }

    class ServicioPerfil {
        +ObtenerActual() Usuario
        +GuardarPerfil(nombre, colorAcento, tamanoFuente, alertasDeudas, alertasMetas, alertasPresupuesto, alertasSobres) Resultado
        +GuardarFoto(foto) Resultado
        +GuardarTema(tema) Resultado
        +CambiarContrasena(actual, nueva, confirmacion) Resultado
    }

    class ServicioAdministracion {
        +EsAdministrador() bool
        +ObtenerResumen() ResumenAdministracion
        +ListarCuentas() List~Usuario~
        +CambiarRol(objetivoId, nuevoRol) Resultado
        +CambiarEstado(objetivoId, activo) Resultado
        +ListarAuditoria(cantidad) List~RegistroAuditoria~
        +ExportarCuentas(ruta) Resultado
    }

    class ServicioReportes {
        +ExportarExcel(ruta) Resultado
        +ExportarPdf(ruta) Resultado
    }

    class ServicioRespaldo {
        +Exportar(ruta) ResumenRespaldo
        +Importar(ruta) ResumenRespaldo
    }

    class ServicioActividad {
        +Registrar(accion)
        +ListarRecientes(cantidad) List~RegistroActividad~
    }

    class ServicioSimuladores {
        +SimularAhorro(meta, ahorroMensual) ResultadoSimulacionAhorro
        +SimularPagoDeuda(deuda, pagoMensual) ResultadoSimulacionDeuda
    }

    class SesionActual {
        +bool HaySesion
        +int UsuarioId
        +RolUsuario Rol
        +Iniciar(usuario)
        +Cerrar()
    }

    class Resultado {
        +bool Exito
        +string Mensaje
    }

