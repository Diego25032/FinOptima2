%% FinOptima - servicios de finanzas personales (capa Logica)
classDiagram
    direction LR

    class ServicioSobres {
        +Listar() List~Sobre~
        +Guardar(sobre) Resultado
        +Eliminar(id) Resultado
        +TotalSaldo() decimal
        +CalcularMonto(ingreso, porcentaje) decimal$
    }

    class ServicioMovimientos {
        +Listar() List~Movimiento~
        +Listar(filtro) List~Movimiento~
        +Guardar(movimiento) Resultado
        +Eliminar(id) Resultado
    }

    class ServicioMetas {
        +Listar() List~MetaResumen~
        +Guardar(meta) Resultado
        +Aportar(metaId, monto) Resultado
        +Eliminar(id) Resultado
        +TotalAhorrado() decimal
    }

    class ServicioDeudas {
        +Listar() List~DeudaResumen~
        +Guardar(deuda) Resultado
        +Abonar(deudaId, monto) Resultado
        +Eliminar(id) Resultado
        +TotalSaldo() decimal
    }

    class ServicioPresupuestos {
        +Listar() List~PresupuestoResumen~
        +Listar(anio, mes) List~PresupuestoResumen~
        +Guardar(presupuesto) Resultado
        +Eliminar(id) Resultado
    }

    class ServicioAlertas {
        +Listar() List~Alerta~
    }

