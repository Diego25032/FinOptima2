<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>FinOptima</AssemblyName>
    <RootNamespace>FinOptima.Presentation</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FinOptima.Domain\FinOptima.Domain.csproj" />
    <ProjectReference Include="..\FinOptima.Application\FinOptima.Application.csproj" />
    <ProjectReference Include="..\FinOptima.Infrastructure\FinOptima.Infrastructure.csproj" />
  </ItemGroup>
</Project>
